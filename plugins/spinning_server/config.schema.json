{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Spinning Server Config",
  "type": "object",
  "properties": {
    "welcome_channel": {
      "type": "string",
      "default": "",
      "description": "Channel ID for welcome messages"
    },
    "goodbye_channel": {
      "type": "string",
      "default": "",
      "description": "Channel ID for goodbye messages"
    },
    "log_channel": {
      "type": "string",
      "default": "",
      "description": "Channel ID for moderation logs"
    },
    "logging_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Enable/disable message logging"
    },
    "autorole_id": {
      "type": "string",
      "default": "",
      "description": "Role ID to auto-assign on join"
    },
    "welcome_message": {
      "type": "string",
      "default": "Welcome to **{server}**, {user}!",
      "description": "Welcome message template"
    },
    "goodbye_message": {
      "type": "string",
      "default": "Goodbye **{user}**, we'll miss you!",
      "description": "Goodbye message template"
    }
  }
}
