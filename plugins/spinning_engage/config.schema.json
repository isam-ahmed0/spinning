{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Spinning Engage Config",
  "type": "object",
  "properties": {
    "xp_min": {
      "type": "number",
      "default": 15,
      "description": "Minimum XP per message"
    },
    "xp_max": {
      "type": "number",
      "default": 35,
      "description": "Maximum XP per message"
    },
    "xp_cooldown": {
      "type": "number",
      "default": 60,
      "description": "Seconds between XP gains"
    },
    "xp_announce_channel": {
      "type": "string",
      "default": "",
      "description": "Channel ID for level-up announcements (empty = current channel)"
    },
    "antiraid_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Enable anti-raid flood detection"
    },
    "antiraid_threshold": {
      "type": "number",
      "default": 5,
      "description": "Messages before triggering anti-raid"
    },
    "antiraid_window": {
      "type": "number",
      "default": 10,
      "description": "Seconds to count messages in"
    },
    "antiraid_mute_duration": {
      "type": "number",
      "default": 300,
      "description": "Seconds to mute raiders"
    }
  }
}
